# SignalTrace local configuration. Copy to .env or set these in the process environment.
SIGNALTRACE_BACKEND_HOST=127.0.0.1
SIGNALTRACE_BACKEND_PORT=8000
SIGNALTRACE_DATABASE_PATH=data/signaltrace.sqlite3
SIGNALTRACE_CHECKPOINT_PATH=data/signaltrace-sysmon-checkpoint.json
SIGNALTRACE_SYSMON_CHANNEL=Microsoft-Windows-Sysmon/Operational
SIGNALTRACE_SYSMON_BATCH_SIZE=100
SIGNALTRACE_SYSMON_MAX_XML_BYTES=2000000
# SIGNALTRACE_RETENTION_DAYS=30
SIGNALTRACE_MINIMUM_PROFILE_OBSERVATIONS=5
SIGNALTRACE_MINIMUM_STATISTICAL_OBSERVATIONS=10
SIGNALTRACE_DETECTION_LOW_THRESHOLD=0.25
SIGNALTRACE_DETECTION_MEDIUM_THRESHOLD=0.55
SIGNALTRACE_DETECTION_HIGH_THRESHOLD=0.80
SIGNALTRACE_CORRELATION_WINDOW_SECONDS=600
# SIGNALTRACE_AI_MODEL_PATH=local-models/explainer.onnx
SIGNALTRACE_AI_PROVIDER=deterministic-fallback
SIGNALTRACE_LOG_LEVEL=INFO
# Comma-separated local frontend origins only.
SIGNALTRACE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
